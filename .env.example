# ─── AlgoMind Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Keys marked CRITICAL will prevent the app from starting if missing.
# Keys marked HIGH will cause silent feature failures at runtime.

# ── CRITICAL — App will not start without these ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # Never commit this value

# ── HIGH — AI Providers (fail silently if missing) ───────────────────────────
GEMINI_API_KEY=                         # Google AI Studio API key (aistudio.google.com)
GROQ_API_KEY=                           # Whisper STT + Groq TTS (flag-gated)
GOOGLE_API_KEY=                         # Optional: Alternative to GEMINI_API_KEY

# ── HIGH — AWS (flag-gated: ENABLE_AWS_POLLY_TTS / ENABLE_AWS_S3_STORAGE) ───
AWS_ACCESS_KEY_ID=                      # Polly TTS + S3 + Transcribe (flag-gated)
AWS_SECRET_ACCESS_KEY=                  # Never commit this value
AWS_S3_BUCKET=algomind-audio            # S3 bucket name
AWS_REGION=ap-south-1                   # Default: ap-south-1 (Mumbai)

# ── HIGH — Redis (rate limiting degrades to fail-open if missing) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=               # Never commit this value

# ── HIGH — Auth & OAuth ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # OAuth callback base URL

# ── MEDIUM — Degraded functionality without these ────────────────────────────
SUPABASE_DIRECT_URL=                    # Supabase Realtime + direct DB
SUPABASE_JWT_SECRET=                    # Custom JWT verification
CRON_SECRET=                            # Nightly batch cron trigger
PISTON_URL=https://emkc.org/api/v2/piston/execute  # Code execution (defaults to public endpoint)
GITHUB_TOKEN=                           # GitHub cron trigger
GITHUB_REPO=owner/repo                  # GitHub cron trigger
DEEPSEEK_API_KEY=                       # DeepSeek model verification only

# ── OPTIONAL — Feature flags, logging & overrides ────────────────────────────
CACHE_BACKEND=                          # 'memory' or 'redis'
NEXT_PUBLIC_FF_ENABLE_RESPONSE_CACHE=   # true/false
NEXT_PUBLIC_FF_ENABLE_SMART_ROUTING=    # true/false
NEXT_PUBLIC_ENABLE_VAD_TEST=            # true/false
NEXT_PUBLIC_VAD_DEBUG=                  # true/false
GEMINI_FREE_TIER_MODEL_ID=             # Optional model string override
GROQ_GPT_OSS_MODEL_ID=                 # Optional model string override
GROQ_GPT_OSS_20B_MODEL_ID=             # Optional model string override
NODE_ENV=development                    # Automatically set by Next.js

# ── Feature Flags (controlled via Admin panel, not env vars) ─────────────────
# ENABLE_WHISPER_STT        → global_feature_flags table, default: false
# ENABLE_AWS_POLLY_TTS      → global_feature_flags table, default: false
# ENABLE_VAD_INTERRUPTIONS  → global_feature_flags table, default: true
